# Machine credentials from app.viam.com -> your machine -> CONNECT -> API key
VIAM_API_KEY=
VIAM_API_KEY_ID=
# Machine address from the same CONNECT tab (required by the demo runtime)
VIAM_MACHINE_ADDRESS=

# Optional OpenRouter vision/localization and voice transcription (server only).
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-30b-a3b-instruct
OPENROUTER_STT_MODEL=openai/whisper-1
