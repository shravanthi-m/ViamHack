def pixel_to_robot(px, py, H):
    d = H[2][0]*px + H[2][1]*py + H[2][2]
    x = (H[0][0]*px + H[0][1]*py + H[0][2]) / d
    y = (H[1][0]*px + H[1][1]*py + H[1][2]) / d
    return x, y
